#!/usr/bin/env zsh

echo ""
echo "══════════════════════════════════════════"
echo "  📝 COMMIT-MSG — Validating format"
echo "══════════════════════════════════════════"
echo ""

npx --no -- commitlint --edit "$1"

if [ $? -ne 0 ]; then
  echo ""
  echo "🔴 Commit message does not follow Conventional Commits."
  echo ""
  echo "   Format: <type>(<scope>): <description> <body>(optional) <footer>(optional)"
  echo ""
  exit 1
fi

echo "  ✅ Commit message is valid."
echo ""

exit 0